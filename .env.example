# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Recipient Email where contact form submissions should be delivered
CONTACT_TO_EMAIL=anurag@ladderframe.in

# Outbound sender email
# During initial testing with Resend free tier, you can use onboarding@resend.dev
# When domain is verified in Resend, use e.g. "LadderFrame Advisors <notifications@ladderframe.in>"
CONTACT_FROM_EMAIL=LadderFrame Enquiry <onboarding@resend.dev>
